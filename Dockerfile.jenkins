FROM jenkins/jenkins:lts-jdk21

# Переключаемся на root, чтобы поставить docker-cli
USER root

# Ставим зависимости для добавления репозитория Docker
RUN apt-get update && \
    apt-get install -y \
        ca-certificates \
        curl \
        gnupg \
        lsb-release && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" | \
      tee /etc/apt/sources.list.d/docker.list > /dev/null && \
    apt-get update && \
    apt-get install -y --no-install-recommends docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

# Возвращаемся к пользователю jenkins (как в оригинальном образе)
USER jenkins

# ВАЖНО: мы НЕ пишем CMD. Оставляем стандартный CMD из jenkins/jenkins,
# который запускает Jenkins.
